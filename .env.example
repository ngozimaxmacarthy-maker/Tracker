# Neon connection string — Vercel > Storage > Neon wires this up for you.
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Any random string of 16+ characters. Vercel sends it as a bearer token on every
# scheduled run; /api/cron refuses to do anything without it.
CRON_SECRET=

# https://resend.com — free tier is 3,000 emails a month. You need two.
RESEND_API_KEY=

# Optional overrides.
REMINDER_TO=ngozi.maxmacarthy@gmail.com
REMINDER_FROM=onboarding@resend.dev
CHECKLIST_URL=
